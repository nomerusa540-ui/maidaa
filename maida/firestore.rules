rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Yordamchi funksiyalar ---------- */
    function signedIn() { return request.auth != null; }

    /* manager.html dagi ADMIN_EMAILS bilan bir xil bo'lsin */
    function isAdmin() { return signedIn() && request.auth.token.email in ['admin@maida.uz']; }

    function hasW() { return signedIn() && exists(/databases/$(database)/documents/waiters/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/waiters/$(request.auth.uid)).data; }
    function isActive() { return hasW() && me().get('active', true) != false; }
    function isManager() { return isActive() && me().get('role', 'waiter') == 'manager'; }

    /* Afitsant smenada: smena boshlangan va 10 soat (SHIFT_HOURS) hali tugamagan */
    function onShift() {
      return isActive() && me().get('role', 'waiter') == 'waiter'
        && me().get('shiftStart', null) != null
        && request.time < me().shiftStart + duration.value(10, 'h');
    }
    function isStaff() { return isAdmin() || isManager() || onShift(); }

    /* ---------- Buyurtmalar ---------- */
    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['table','items','note','total','status','open','lang','by','createdAt','expireAt'])
        && d.table is string && d.table.size() > 0 && d.table.size() <= 8
        && d.items is list && d.items.size() > 0 && d.items.size() <= 60
        && d.get('note', '') is string && d.get('note', '').size() <= 200
        && d.total is number && d.total >= 0 && d.total <= 1000000000
        && d.open == true
        && d.createdAt == request.time
        && d.expireAt is timestamp && d.expireAt <= request.time + duration.value(45, 'd')
        && ( (!('by' in d) && d.status == 'new')
          || (d.get('by', '') == 'waiter' && onShift() && d.status == 'accepted') );
    }

    match /orders/{id} {
      /* mijoz o'z buyurtmasini ID bo'yicha kuzatadi; ID tasodifiy va topib bo'lmaydi */
      allow get: if true;
      /* mijoz faqat ochiq buyurtmalarni so'raydi (where open == true); xodimlar hammasini */
      allow list: if isStaff() || resource.data.open == true;
      allow create: if validOrder();
      allow update: if onShift()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','open'])
        && request.resource.data.status in ['new','accepted','served','cancelled','billed'];
      allow delete: if false;
    }

    /* ---------- Afitsantni chaqirish ---------- */
    match /calls/{id} {
      allow create: if request.resource.data.keys().hasOnly(['table','status','createdAt','expireAt'])
        && request.resource.data.table is string && request.resource.data.table.size() <= 8
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(10, 'd');
      allow read: if isStaff();
      allow update: if onShift()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'done';
      allow delete: if false;
    }

    /* ---------- Stollar (qaysi stol kimniki) ---------- */
    function validTable() {
      let d = request.resource.data;
      return onShift()
        && d.keys().hasOnly(['uid','name','until'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 60
        && d.until is timestamp && d.until <= request.time + duration.value(10, 'h');
    }
    match /tables/{tb} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if validTable();
      allow update: if validTable() && (resource.data.uid == request.auth.uid || resource.data.until <= request.time);
      allow delete: if isAdmin() || (onShift() && (resource.data.uid == request.auth.uid || resource.data.until <= request.time));
    }

    /* ---------- Xodimlar ---------- */
    match /waiters/{uid} {
      allow get: if isAdmin() || isManager() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin() || isManager();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || ( signedIn() && request.auth.uid == uid
          && isActive() && me().get('role', 'waiter') == 'waiter'
          /* eshikdagi QR kod orqali smenani ochish */
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shiftStart','code'])
          && request.resource.data.shiftStart == request.time
          && request.resource.data.code == get(/databases/$(database)/documents/config/shift).data.code
          && (resource.data.get('shiftStart', null) == null
              || resource.data.shiftStart + duration.value(10, 'h') <= request.time) );
    }

    /* ---------- Smena QR kodi (faqat admin) ---------- */
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    /* ---------- Kunlik hisobot ---------- */
    match /reports/{day} {
      allow read: if isAdmin();
      allow create, update: if onShift()
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['date','checks','total','items','updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
